+fn worker_kani_harnesses_exist(root: &Path) {
+    let worker = root.join("crates/keyrack-crypto-worker");
+    let registry: serde_json::Value = serde_json::from_str(
+        &read(&worker.join("verification/kani-harnesses.json")),
+    ).expect("worker proof registry");
+    let proofs = read(&worker.join(registry["proofs"].as_str().expect("proof path")));
+    let doc = read(&worker.join("VERIFICATION.md"));
+    let registered: std::collections::BTreeSet<_> = registry["harnesses"]
+        .as_array().expect("worker harness list").iter()
+        .map(|name| name.as_str().expect("harness name")).collect();
+    assert!(!registered.is_empty(), "worker harness registry must not be empty");
+    let actual: std::collections::BTreeSet<_> = proofs.split("#[kani::proof]")
+        .skip(1).map(|part| part.split("fn ").nth(1).expect("proof function")
+            .split('(').next().expect("proof name").trim()).collect();
+    assert_eq!(registered, actual, "worker proof annotations and registry differ");
+    let documented = documented_harness_names(&doc);
+    let documented: std::collections::BTreeSet<_> = documented.iter().map(String::as_str).collect();
+    assert_eq!(registered, documented, "worker proof documentation and registry differ");
+}
